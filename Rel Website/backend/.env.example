# ============================================================
# REL REQUEST PROCESS FLOW - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and update values before running the app
#
# For LAN Sharing:
#   1. Set HOST=0.0.0.0 to listen on all network interfaces
#   2. Set PORT to a free port (8000 is default)
#   3. Make sure Windows Firewall allows the port (see LAN_SHARING_GUIDE.md)
#   4. Access from other machines at: http://<your-ip>:8000
# ============================================================

# ============================================================
# NETWORK CONFIGURATION (For LAN Sharing)
# ============================================================

# Host: Which network interface to listen on
# Set to 0.0.0.0 for LAN sharing (listen on all interfaces)
# Set to 127.0.0.1 for localhost only
HOST=0.0.0.0

# Port: Server port (make sure Windows Firewall allows this port)
PORT=8000

# ============================================================
# WORKER CONFIGURATION
# ============================================================

# Number of uvicorn worker processes (keep at 1 for single server)
WORKERS=1

# Auto-reload on code changes (false for production)
RELOAD=false

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Old MongoDB config (for reference, now using SQLite)
# MONGO_URL=mongodb://mongo:27017
# DB_NAME=rel_db

# Current: SQLite database (stored at backend/rel_database.db)
DATABASE_PATH=backend/rel_database.db

# ============================================================
# SECURITY (⚠️  Important: Change these in production!)
# ============================================================

# JWT Secret Key - CHANGE THIS TO A RANDOM STRING!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-secure-value-min-32-chars

# JWT Token Expiration (in hours)
JWT_EXPIRATION_HOURS=24

# ============================================================
# CORS CONFIGURATION
# ============================================================

# Allowed origins for API requests (comma-separated)
# For LAN: use http://localhost:8000,http://<your-ip>:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ============================================================
# OPTIONAL: EMAIL CONFIGURATION (for notifications)
# ============================================================

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@your-domain.com

# ============================================================
# OPTIONAL: LOGGING CONFIGURATION
# ============================================================

# Log level: debug, info, warning, error
LOG_LEVEL=info

# ============================================================
# OPTIONAL: FEATURE FLAGS
# ============================================================

# Enable maintenance mode (prevent user access)
MAINTENANCE_MODE=false
