      "avatars": [
        "https://images.unsplash.com/photo-1769636929261-e913ed023c83?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxOTF8MHwxfHNlYXJjaHwyfHxtYW4lMjBwb3J0cmFpdCUyMGNvcnBvcmF0ZSUyMGhlYWRzaG90fGVufDB8fHx8MTc3MDcwNzUwOXww&ixlib=rb-4.1.0&q=85",
        "https://images.unsplash.com/photo-1762522926984-e721bff0d6c6?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxODF8MHwxfHNlYXJjaHwyfHx3b21hbiUyMHBvcnRyYWl0JTIwY29ycG9yYXRlJTIwaGVhZHNob3R8ZW58MHx8fHwxNzcwNzA3NTEwfDA&ixlib=rb-4.1.0&q=85",
        "https://images.unsplash.com/photo-1758599543120-4e462429a4d7?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NTYxODF8MHwxfHNlYXJjaHwxfHx3b21hbiUyMHBvcnRyYWl0JTIwY29ycG9yYXRlJTIwaGVhZHNob3R8ZW58MHx8fHwxNzcwNzA3NTEwfDA&ixlib=rb-4.1.0&q=85"
