{
  "design_identity": {
    "persona": "E1 - The Anti-AI Designer",
    "theme": "Tactical Industrial",
    "core_principles": [
      "Fusion over Imitation",
      "Emotion First: Trust & Precision",
      "Content is King: Data Density",
      "Contrast: High Utility"
    ],
    "anti_patterns": [
      "Generic purple/teal gradients",
      "Center-aligned everything",
      "Low contrast text",
      "Excessive whitespace in data tables"
    ]
  },
  "typography": {
    "font_family": {
      "headings": "Manrope, sans-serif",
      "body": "Inter, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "scale": {
      "h1": "text-4xl font-bold tracking-tight text-slate-900",
      "h2": "text-2xl font-bold tracking-tight text-slate-800",
      "h3": "text-xl font-semibold text-slate-800",
      "body": "text-sm text-slate-600 leading-relaxed",
      "label": "text-xs font-medium uppercase tracking-wider text-slate-500"
    }
  },
  "colors": {
    "palette": {
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "sidebar": "#0F172A",
      "border": "#E2E8F0",
      "primary": "#2563EB",
      "primary_foreground": "#FFFFFF",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "neutral": "#64748B"
    },
    "usage": {
      "sidebar_bg": "bg-slate-950",
      "sidebar_text": "text-slate-400",
      "sidebar_active": "bg-blue-600 text-white",
      "card_bg": "bg-white border border-slate-200 shadow-sm",
      "status_completed": "bg-emerald-100 text-emerald-700 border-emerald-200",
      "status_active": "bg-blue-100 text-blue-700 border-blue-200 animate-pulse",
      "status_pending": "bg-slate-100 text-slate-500 border-slate-200",
      "status_failed": "bg-red-100 text-red-700 border-red-200"
    }
  },
  "layout_strategies": {
    "dashboard": {
      "type": "Bento Grid Mode B (High Density)",
      "grid_cols": "grid-cols-1 md:grid-cols-4 gap-4",
      "cards": [
        "Summary Metrics (col-span-1)",
        "Main Chart (col-span-2 row-span-2)",
        "Recent Activity List (col-span-1 row-span-2)"
      ]
    },
    "request_details": {
      "type": "Master-Detail",
      "structure": "Sidebar (Process Steps) + Main Content (Step Details)",
      "mobile_strategy": "Vertical Timeline Accordion"
    },
    "spacing": {
      "container": "p-6 md:p-8 max-w-7xl mx-auto",
      "card_padding": "p-6",
      "section_gap": "gap-8"
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-slate-900 hover:bg-slate-800 text-white rounded-md px-4 py-2 font-medium transition-all shadow-sm hover:shadow-md",
      "secondary": "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-md px-4 py-2 font-medium transition-all",
      "ghost": "text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md px-3 py-1.5 transition-all"
    },
    "inputs": {
      "base": "border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 rounded-md bg-slate-50 focus:bg-white transition-all"
    },
    "cards": {
      "style": "bg-white border border-slate-200 rounded-lg shadow-[0_2px_4px_rgba(0,0,0,0.02)] hover:shadow-[0_4px_8px_rgba(0,0,0,0.04)] transition-shadow duration-300"
    },
    "badges": {
      "style": "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border"
    }
  },
