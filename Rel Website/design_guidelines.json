    },
    "icons": {
      "library": "lucide-react",
      "required": ["Activity", "Box", "CheckCircle", "AlertTriangle", "Clock", "Settings", "Users", "FileText", "Search", "Filter", "LogOut", "ChevronRight", "Menu", "X"]
    }
  },
  "motion_guidelines": {
    "transitions": "transition-all duration-200 ease-in-out",
    "hover_effects": "hover:translate-y-[-1px] hover:shadow-md",
    "loading": "animate-pulse bg-slate-200",
    "page_enter": "animate-in fade-in slide-in-from-bottom-4 duration-500"
  },
  "specific_instructions": [
    "Use 'Manrope' from Google Fonts for all headings. Import it in index.css.",
    "Implement a 'Sidebar' component that is fixed on the left for desktop, and drawer for mobile.",
    "Create a 'ProcessTimeline' component that visualizes the 14 steps linearly. Use horizontal scroll for desktop if needed, or a vertical list for mobile.",
    "For the 'Request Details' page, use a split view: Step List (Left) -> Step Details Form (Right).",
    "Ensure the 'Bake' and 'Reflow' steps visually stand out as 'Processing' steps (maybe an animated icon).",
    "Use 'sonner' for all toast notifications (Success, Error, Updates).",
    "All interactive elements MUST have data-testid attributes.",
    "Do NOT use gradients for the main background. Keep it clean 'slate-50'.",
    "Dashboard charts should use 'recharts' with the custom color palette provided."
  ]
}