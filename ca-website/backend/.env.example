# ============================================================
# CA WEBSITE - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and update values before running the app
#
# For LAN Sharing:
#   1. Set HOST=0.0.0.0 to listen on all network interfaces
#   2. Set PORT (or CA_PORT) to a free port (8001 is default for CA)
#   3. Make sure Windows Firewall allows the port (see LAN_SHARING_GUIDE.md)
#   4. Access from other machines at: http://<your-ip>:8001
# ============================================================

# ============================================================
# NETWORK CONFIGURATION (For LAN Sharing)
# ============================================================

# Host: Which network interface to listen on
# Set to 0.0.0.0 for LAN sharing (listen on all interfaces)
# Set to 127.0.0.1 for localhost only
HOST=0.0.0.0

# Port: Server port (CA Website uses 8001 by default)
# You can also use CA_PORT which takes precedence
# Make sure Windows Firewall allows this port!
PORT=8001
CA_PORT=8001

# ============================================================
# WORKER CONFIGURATION
# ============================================================

# Number of uvicorn worker processes (keep at 1 for single server)
WORKERS=1

# Auto-reload on code changes (false for production)
RELOAD=false

# ============================================================
# SECURITY (⚠️  Important: Change these in production!)
# ============================================================

# CA Secret Key - CHANGE THIS TO A RANDOM STRING!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CA_SECRET_KEY=ca-secret-key-change-in-production

# REL Database Path - Location of the Rel Request database for user sync
# Default: ../Rel Website/backend/rel_database.db
# REL_DB_PATH=../Rel Website/backend/rel_database.db

# ============================================================
# OPTIONAL: LOGGING CONFIGURATION
# ============================================================

# Log level: debug, info, warning, error
LOG_LEVEL=info

# ============================================================
# OPTIONAL: FEATURE FLAGS
# ============================================================

# Enable maintenance mode (prevent user access)
MAINTENANCE_MODE=false
